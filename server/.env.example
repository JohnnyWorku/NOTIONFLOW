NODE_ENV=development
PORT=4000

# Notion (backend only, never commit the real values)
NOTION_TOKEN=
# Verify the supported version in Notion docs; 2025-09-03 introduced data sources.
NOTION_API_VERSION=2025-09-03

# Database / data source IDs. Find them with GET /api/notion/databases after the token works.
NOTION_TASKS_DB=
NOTION_PROJECTS_DB=
NOTION_GOALS_DB=
NOTION_LEARNING_DB=
# Optional: JSON file overriding property names per kind (see docs/notion-setup.md)
NOTION_MAPPING_PATH=

# Auth: clients send "Authorization: Bearer <APP_API_KEY>". Generate: openssl rand -hex 32
APP_API_KEY=

# Comma-separated allowed browser origins
WEB_ORIGIN=http://localhost:3000

# Notion webhook verification token (pasted from Notion UI after subscription is created)
NOTION_WEBHOOK_SECRET=

NODE_ENV=development
PORT=4000

# ---- Notion (backend only, never commit real values) ----
NOTION_TOKEN=
# Leave blank to use the SDK default. Only set it if Notion reports a version problem.
NOTION_API_VERSION=

# Built-in databases (IDs from GET /api/notion/databases). Leave blank to disable that section.
NOTION_TASKS_DB=
NOTION_PROJECTS_DB=
NOTION_GOALS_DB=
NOTION_LEARNING_DB=

# Extra tables (Spiritual, Health, Finance...). One-line JSON array, see docs/custom-collections.md
# NOTION_COLLECTIONS=[{"key":"spiritual","label":"Spiritual","databaseId":"PASTE_ID","icon":"moon"}]
# Or keep it in a file instead:
# NOTION_COLLECTIONS_PATH=./collections.json
# Optional per-collection property overrides: NOTION_MAPPING_PATH=./notion-mapping.json
NOTION_MAPPING_PATH=

# Optional: ID of your Notion HOME page (the one that links your tables). NotionFlow mirrors it on the Home screen.
# Open the page in Notion -> ... -> Copy link: the 32-character code at the end is the ID. Share the page with the integration.
NOTION_HOME_PAGE_ID=

# Optional: pin extra Notion pages (e.g. your Spiritual page) in the menus. One-line JSON; ids are the 32 characters at the end of a page link.
# Pages linked from your Notion home page, and the page each table lives on, are found automatically.
# NOTION_PAGES=[{"id":"PASTE_PAGE_ID","label":"Spiritual","icon":"moon"}]

# Optional: force a card design for any table (task, project, goal, learning, habit, note, standard).
# Without this each table gets the design that fits its name and properties.
# NOTION_CARD_STYLES={"spiritual":"habit","reading":"learning"}

# ---- Login ----
# The single password you type on the web/mobile login screen (min 8 chars).
APP_PASSWORD=
# Secret used to sign session tokens (min 32 chars). Generate: openssl rand -hex 32
AUTH_SECRET=
# Optional static key for scripts/automation (Authorization: Bearer <key>). Leave blank if unused.
APP_API_KEY=

# Comma-separated browser origins allowed to call the API directly (the web app talks via its server, so this is a backup)
WEB_ORIGIN=http://localhost:3000

# Notion webhook verification token (after creating the webhook subscription)
NOTION_WEBHOOK_SECRET=
